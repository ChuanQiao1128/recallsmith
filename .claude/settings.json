{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.config/developercards/**)",
      "Edit(~/.config/developercards/**)",
      "Grep(~/.config/developercards/**)",
      "Bash(*mcp-tokens*)",
      "Bash(*.config/developercards*)",
      "Read(./**/.env*)",
      "Read(./**/*.tfstate*)",
      "Read(./**/*.tfvars)",
      "Read(./**/*.pem)"
    ]
  }
}
