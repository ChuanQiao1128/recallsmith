{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "mobile",
  "version": "1.6.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:unit:watch": "vitest tests/unit",
    "test:integration:watch": "vitest tests/integration",
    "test:coverage": "vitest run --coverage",
    "test": "npm run test:typecheck && npm run test:unit && npm run test:integration && npm run test:smoke",
    "test:smoke": "rm -rf .tmp-tests && npx tsc --module commonjs --target es2020 --outDir .tmp-tests tests/p2-smoke.ts && node .tmp-tests/tests/p2-smoke.js && rm -rf .tmp-tests"
  },
  "dependencies": {
    "@aws-amplify/react-native": "^1.3.1",
    "@babel/runtime": "^7.28.4",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.22",
    "@react-navigation/native-stack": "^7.8.3",
    "@shopify/react-native-skia": "2.2.12",
    "aws-amplify": "^6.15.9",
    "expo": "~54.0.20",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.12",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.11",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "^15.0.7",
    "expo-linking": "~8.0.9",
    "expo-notifications": "~0.32.14",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-store-review": "~9.0.9",
    "expo-updates": "~29.0.15",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-purchases": "^9.6.11",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-worklets": "0.5.1",
    "rxjs": "^7.8.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/estree": "^1.0.8",
    "@types/node": "^25.6.0",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "@vitest/coverage-v8": "^4.1.5",
    "expo-module-scripts": "^5.0.8",
    "fast-check": "^4.9.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2",
    "vite": "7.2.4",
    "vitest": "^4.1.5"
  },
  "private": true
}
