# Build-time configuration for the Playwright smoke tests, loaded by
# `vite build --mode e2e` (see playwright.config.ts).
#
# Committed for the same reason .env.development is: every value here is public
# by construction, and two of them are deliberately not real.
#
# WHY A SEPARATE MODE AT ALL
# --------------------------
# `npm run build` defaults to mode "production", which loads .env and
# .env.production — neither of which exists — so the bundle it produces has no
# Cognito configuration at all. AUTH_CONFIGURED is then false, RequireAuth waves
# every route through without a session, and the sign-in button renders
# disabled. Both smoke tests would be exercising an application that has had its
# auth removed, and both would still pass. This mode is what makes the built
# bundle the one the tests think they are driving.
#
# Building against .env.development instead would work and was rejected: it
# points at the real dev API Gateway and the real Cognito user pool, so a
# mis-stubbed request would leave localhost and reach a live service.

# RFC 2606 reserves .invalid so that it can never resolve. Every OAuth redirect
# in these tests is intercepted by page.route() before it leaves; this is the
# second guard, and it is the one that holds if the first is ever removed.
VITE_COGNITO_DOMAIN=https://auth.e2e.invalid
VITE_COGNITO_CLIENT_ID=e2e-client-id
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/login
VITE_COGNITO_SCOPES=openid email profile

# Empty on purpose, and it must stay assigned rather than omitted: an untracked
# .env.local sits beside this file on a developer machine carrying the real dev
# API Gateway host, and .env.<mode> outranks it only for keys it actually names.
# With this empty, src/api/http.ts falls back to a same-origin base URL, so
# every API call is http://localhost:5173/api/... and page.route() can answer it.
VITE_API_BASE=
VITE_API_BASE_URL=

# Left unset, so src/lib/reportError.ts makes zero network calls: a smoke test
# should not be beaming stacks at anything.
# VITE_ERROR_REPORT_URL=
