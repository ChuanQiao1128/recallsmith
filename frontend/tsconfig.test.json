{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",

    // Both entries are load-bearing; each was verified by removing it and
    // counting the errors that appeared.
    //
    // "node": 11 test files import node builtins (node:fs x11, node:url x11,
    // node:path x6, node:child_process x2, node:os x1) because the census and
    // wiring tests read the repo off disk. Dropping it yields 34 errors, all
    // in tests/.
    //
    // "vite/client": tests import src, and src reads import.meta.env in
    // src/api/http.ts, src/api/contentManifest.ts, src/auth/authConfig.ts and
    // src/perf/journey.ts; src/components/CardForm.tsx imports a .css file.
    // Dropping it yields 11 errors (10x TS2339 on import.meta.env, 1x TS2307
    // on the css import), all in src/ rather than tests/.
    //
    // Deliberately NOT "vitest/globals": vitest.config.ts sets globals: false
    // and every test file imports describe/it/expect explicitly. Adding the
    // globals types would make a test that forgot its imports type-check here
    // and then fail at runtime, which is strictly worse than the status quo.
    // (This sentence used to carry a file count. It drifted the moment a test
    // was added, which is the same defect the file-set assertion below exists
    // to stop; a number that nothing checks does not belong in prose.)
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting - deliberately identical to tsconfig.app.json. Test files are
       held to the same strictness as src; relaxing any of these here would let
       a test paper over a type it is supposed to be pinning down. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["tests"],

  // iCloud conflict copies. This repo lives in an iCloud-synced folder, which
  // resolves a conflict by renaming the losing copy to "name 2.ext". Because
  // "include" above is a directory glob, such a file is compiled the moment it
  // appears, and it has broken this build before (see the root .gitignore).
  //
  // One pattern, resting on two invariants that were measured rather than
  // assumed:
  //
  //   1. Every conflict copy macOS produces contains a SPACE. That is the whole
  //      signature - "cardForm 2.tsx", "cardForm.test 2.tsx",
  //      "deckImport 2.test.ts", "vitest.config 2.ts" (the one real example
  //      currently sitting in frontend/, gitignored). The digit's position
  //      varies; the space does not.
  //   2. No legitimate path in this repository contains a space. Checked with
  //      `find . -name '* *'` over frontend/ outside node_modules/ and dist/:
  //      the only hits are that conflict copy and a scratch directory.
  //
  // So "any path containing a space" is exactly the set to drop, and TypeScript
  // globs take a literal space. Measured in a fixture with planted files and
  // --listFilesOnly: this drops "cardForm 2.tsx", "cardForm.test 2.tsx",
  // "deckImport 2.test.ts", "deckImport.test 2.ts", "vitest.config 2.ts",
  // "support/helper 2.ts" and anything inside a spaced DIRECTORY, while keeping
  // "apiV2.test.ts", "helper2.ts", "typeGateFileSet2.test.ts", "a1.ts", "b10.ts".
  // Against the real tree it drops zero files.
  //
  // It replaces a 32-entry enumeration of "**/*?2.ts" ... "**/*?9.test.tsx",
  // whose reasoning was wrong in a way that mattered: "?" was believed to
  // absorb the space, but "?" matches ANY character, so those patterns also
  // swallowed ordinary files whose basename ended in a digit 2-9 - measured:
  // "apiV2.test.ts" and "helper2.ts" vanished from the program while vitest
  // went on running them. A file in that state is type-checked by nothing.
  //
  // That class of hole is no longer a matter of anyone reading this comment
  // carefully: tests/typeGateFileSet2.test.ts compares the file set this config
  // resolves to against the files actually on disk, and its own name is on the
  // wrong side of the old bug on purpose.
  //
  // (This glob is listed with // rather than inside a /* */ block on purpose:
  // a glob beginning "**/" contains the sequence "*/", which would close a
  // block comment early and make this file unparseable.)
  "exclude": ["**/* *"]
}
