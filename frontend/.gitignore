# Playwright output. Both directories are written by a run, not by a person:
# test-results/ holds traces and screenshots kept only for a failure,
# playwright-report/ the HTML report. Ignored rather than cleaned up by hand
# because tests/rootReadmePaths.test.ts counts `git ls-files frontend`, so an
# unignored artefact directory would make a passing run change the README's
# file count. Browser binaries live in ~/Library/Caches/ms-playwright and never
# enter the repository.
test-results/
playwright-report/
blob-report/
.playwright/

# ReleaseGuard scanner artifacts (auto-generated, not source)
.releaseguard/
artifacts/releaseguard/
_archive_duplicates/

# macOS and iCloud conflict copies. These appear as "Foo 2.tsx" next to the
# real file and are indistinguishable from source to every tool that globs by
# extension: tsconfig compiled them and broke the build once already. Ignoring
# them keeps a sync artefact from becoming a committed file.
* [0-9].ts
* [0-9].tsx
* [0-9].js
* [0-9].json
