# The deployed console at https://d12pfy1rhi3ekm.cloudfront.net (CloudFront in
# front of a private S3 bucket, OAC-signed). Committed for the same reason
# .env.development is: every value here is public by construction — the client
# id and domain travel in every OAuth redirect, and the API base is in every
# request this app makes.
#
# Vite loads this for plain `vite build` (mode production). Mode-specific files
# outrank .env.local, so a developer's local overrides cannot leak into a
# deploy artifact. Local dev (`npm run dev`) reads .env.development and never
# sees this file; the e2e suite builds with --mode e2e and reads .env.e2e.
VITE_API_BASE=https://ktbq1sie2c.execute-api.ap-southeast-2.amazonaws.com/dev

VITE_COGNITO_DOMAIN=https://ap-southeast-24vf8ucxkt.auth.ap-southeast-2.amazoncognito.com
VITE_COGNITO_CLIENT_ID=6lkofepp2llp6v4nueg52mcm5v
VITE_COGNITO_REDIRECT_URI=https://d12pfy1rhi3ekm.cloudfront.net/auth/callback
VITE_COGNITO_LOGOUT_URI=https://d12pfy1rhi3ekm.cloudfront.net/
VITE_COGNITO_SCOPES=openid email profile
