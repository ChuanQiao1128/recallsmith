# Copy to .env.development.local (gitignored) and fill in your dev values.
# .env.development is committed and holds defaults safe to share with the team.

# API base URL the SPA hits at runtime. In dev we usually leave this blank and
# rely on the Vite proxy below; in prod it's set to the real API Gateway URL.
VITE_API_BASE=

# Vite dev-server proxy target. Leave blank to disable the proxy (then set
# VITE_API_BASE to an absolute URL). Replace with your team's dev backend.
VITE_DEV_PROXY_TARGET=https://YOUR-API-ID.execute-api.YOUR-REGION.amazonaws.com/dev

# Cognito hosted UI configuration. Leaving any of DOMAIN/CLIENT_ID/REDIRECT_URI
# blank disables auth (RequireAuth treats the user as authenticated — useful
# for local UI work without a real Cognito pool).
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
VITE_COGNITO_SCOPES=openid email profile
