<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Build only the Public lambda (to keep the deployment zip small). -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);LAMBDA_PUBLIC</DefineConstants>

    <!-- Keep handler strings stable across zips. -->
    <AssemblyName>RecallSmith.Lambda</AssemblyName>
    <RootNamespace>RecallSmith.Lambda</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="PublicFunction.cs" />
    <Compile Include="Common/**/*.cs" />
    <Compile Include="Public/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.APIGatewayEvents" Version="2.7.3" />
    <PackageReference Include="Amazon.Lambda.Core" Version="2.5.0" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="2.4.0" />
    <PackageReference Include="AWSSDK.Core" Version="4.0.0" />
    <PackageReference Include="AWSSDK.CognitoIdentityProvider" Version="4.0.0" />
  </ItemGroup>
</Project>

